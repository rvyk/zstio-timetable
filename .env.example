# REQUIRED
NEXT_PUBLIC_TIMETABLE_URL="http://www.zstio-elektronika.pl/plan/"
NEXT_PUBLIC_APP_URL="http://localhost:3000/"

# OPTIONAL
# BUILD_STANDALONE="true"

# SENTRY_AUTH_TOKEN=""
# SENTRY_SUPPRESS_TURBOPACK_WARNING=1

# NEXT_PUBLIC_SCHOOL_NEWS_URL="https://zstiojar.edu.pl/wp-json/wp/v2/posts"

# Link to the unofficial timetable - button hidden without it or if the URL is down
# NEXT_PUBLIC_ALT_TIMETABLE_URL="https://www.zstio-elektronika.pl/nowy-plan/"

# Set on non-Vercel hosts (Coolify etc.) - /_vercel/insights/script.js 404s there
# NEXT_PUBLIC_DISABLE_ANALYTICS="true"

# Discord webhook for timetable change notifications
# Without it the watcher stays off - no cron, no requests
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Run the watcher in-process every N minutes (needs DISCORD_WEBHOOK_URL)
# Keep it at 15+ - timetable fetches are cached for 900s anyway
# Ignored on Vercel, where instances freeze between requests
# PLAN_WATCH_INTERVAL_MINUTES="20"

# Guards GET /api/plan-watch, the manual trigger for the same run
# PLAN_WATCH_SECRET=""

# Where the previous plan snapshot is stored, defaults to ./data/plan-snapshots.json
# Point it at a mounted volume so it survives restarts
# PLAN_SNAPSHOT_PATH="/app/data/plan-snapshots.json"
